generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email       String  @id
  password    String
  fullName    String
  phone       String  @default("")
  address     String  @default("")
  isAdmin     Boolean @default(false)
  // null = full admin (every market, current behavior); a specific Market scopes this admin
  // to only that storefront's products - see admin-emails.util.ts and AdminGuard.
  adminMarket Market?
}

model Category {
  id        String    @id
  name      Json // { ru, en, ar }
  // Uploaded icon for the category filter pill (data URI or URL); null = fall back to the default red logo mark
  icon      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  // Which storefront(s) list this category - same semantics as Product.markets.
  markets   Market[]  @default([main])
  // Two back-relations because a product is filed under one category per storefront - see
  // Product.categoryId / Product.categoryIdAr.
  products   Product[] @relation("ProductCategoryMain")
  productsAr Product[] @relation("ProductCategoryAr")
}

enum ProductType {
  peptide
  additional_good
}

// Which storefront(s) a product is listed on - nadeck.net ('main') and/or ar.nadeck.net ('ar').
// Independent of the product's translated content (name/description already carry ru/en/ar).
enum Market {
  main
  ar
}

// The measurement unit each volume/price entry is denominated in. Independent of ProductType -
// a peptide can be sold as powder (mg) or pre-mixed liquid (ml), and an additional good can be
// unit-counted (pcs, e.g. syringes) or volume-based (ml, e.g. bacteriostatic water).
enum ProductUnit {
  mg
  ml
  pcs
}

// Base catalog entity shared by every sellable item, regardless of type. Type-specific
// attributes live on a details table (MedicineDetails today; more will follow as new
// product types need their own strongly-typed fields) so adding a new type never requires
// widening this table with nullable columns nobody else uses.
model Product {
  id              String      @id
  type            ProductType @default(peptide)
  unit            ProductUnit @default(mg)
  name            Json // { ru, en, ar }
  // One category per storefront, because the two markets keep entirely separate category
  // rows (Category.markets) - a single shared id would always be an orphan on one of them.
  // `categoryId` is nadeck.net's; `categoryIdAr` is ar.nadeck.net's and falls back to
  // `categoryId` when unset, mirroring how images/imagesAr behave.
  categoryId      String      @default("weightloss")
  category        Category    @relation("ProductCategoryMain", fields: [categoryId], references: [id], onDelete: Restrict)
  categoryIdAr    String?
  categoryAr      Category?   @relation("ProductCategoryAr", fields: [categoryIdAr], references: [id], onDelete: Restrict)
  description     Json // { ru, en, ar }
  fullDescription Json // { ru, en, ar }
  images          Json @default("[]") // string[] of image URLs for nadeck.net - images[0] is the cover photo
  // Same, but for ar.nadeck.net - the two storefronts can show different photos of the same
  // product. Empty here means that site falls back to `images` (and an empty `images` falls
  // back to this), so a product still only needs one gallery unless the markets differ.
  imagesAr        Json @default("[]")
  rating          Float
  inStock         Int
  markets         Market[]    @default([main])

  medicine        MedicineDetails?
  additionalGood  AdditionalGoodDetails?
}

// Peptide-specific clinical/dosing fields. Only exists for products with type = peptide.
model MedicineDetails {
  productId         String  @id
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  indications       Json // { ru: string[], en: string[], ar: string[] }
  contraindications Json // { ru: string[], en: string[], ar: string[] }
  usage             Json // { ru, en, ar }
  form              String
  mgPerUnit         Float
  dosageRules       Json // { mgPerKgPerDay, defaultDailyDoses }
  // [{ mgPerUnit, price, priceUsd, priceSar }] volume options - price lives only here, tied to
  // the strength. priceSar (SAR) is independent of priceUsd, not derived from it - shown on
  // ar.nadeck.net for the Arabic language (English there still shows priceUsd).
  volumes           Json @default("[]")
}

// Everything that isn't a peptide (syringes, vitamins, protein, cosmetics, equipment, ...).
// A single shared bucket until a specific type needs fields none of the others do - at that
// point it gets its own details table instead of widening this one.
model AdditionalGoodDetails {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // [{ mgPerUnit, price, priceUsd, priceSar }] pack-size options - mgPerUnit here just means
  // "units per pack"
  volumes   Json @default("[]")
}

// Where orders can be shipped and what shipping costs there. Admin-managed so opening a new
// destination doesn't need a deploy - these fees used to be hardcoded in the frontend's
// currency.ts. There is deliberately no free-delivery tier: every country charges its flat fee.
model DeliveryCountry {
  code      String   @id // ISO 3166-1 alpha-2, uppercase (KZ, SA, AE, ...)
  name      Json // { ru, en, ar }
  priceKzt  Float    @default(0)
  priceUsd  Float    @default(0)
  priceSar  Float    @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  // Which storefront offers this destination - same semantics as Product.markets/Category.markets.
  markets   Market[] @default([main])
}

// A code handed to a partner, who passes it on to their clients: the client types it at
// checkout and gets a percentage off. Percent rather than a fixed sum because the storefront
// sells in three currencies (KZT/USD/SAR) - one percentage covers all of them.
model PromoCode {
  code            String  @id // uppercase, exactly what the customer types
  partnerName     String  @default("") // whose code this is - the label in the admin stats table
  discountPercent Float // 0-100, taken off the goods subtotal only, never off delivery
  isActive        Boolean @default(true)
  maxUses         Int? // null = unlimited; counts orders, not people
  expiresAt       String? // ISO date, null = no expiry
  createdAt       String
}

model Order {
  id            String @id
  date          String
  userEmail     String
  items         Json // [{ medicineName, price, priceUsd, priceSar, quantity }]
  totalPrice    Float // KZT grand total
  totalPriceUsd Float @default(0) // USD grand total
  totalPriceSar Float @default(0) // SAR grand total (ar.nadeck.net, Arabic language)
  address       Json // { city, street, apartment, postalCode }
  paymentMethod String
  status        String @default("pending")

  // Promo code used at checkout, uppercase. Deliberately plain text and not a relation to
  // PromoCode: deleting a retired code must not erase which orders it brought in, and the
  // "how many clients did this partner send" figures are counted from this column.
  promoCode       String?
  discountPercent Float   @default(0)
  // What the discount actually took off, per currency. The totalPrice* above are already net of it.
  discountKzt     Float   @default(0)
  discountUsd     Float   @default(0)
  discountSar     Float   @default(0)

  @@index([promoCode])
}

model StockSubscription {
  id         String @id @default(cuid())
  email      String
  medicineId String
  notified   Int    @default(0)
  createdAt  String

  @@unique([email, medicineId])
}

model Notification {
  id         String @id @default(cuid())
  email      String
  medicineId String
  message    Json // { ru, en, ar }
  createdAt  String
  read       Int    @default(0)
}

model NewsletterSubscriber {
  email     String @id
  createdAt String
}
