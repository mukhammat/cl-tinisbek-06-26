generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email       String  @id
  password    String
  fullName    String
  phone       String  @default("")
  address     String  @default("")
  isAdmin     Boolean @default(false)

  // Set once the customer types the 6-digit code mailed to them. Only a mark (shown to the
  // customer and next to their orders in the admin panel) - nothing is blocked without it.
  emailVerified       Boolean @default(false)
  verifyCode          String? // SHA-256 of email:code, never the code itself
  verifyCodeExpiresAt String? // ISO
  verifyCodeSentAt    String? // ISO, for the one-minute resend cooldown
  verifyAttempts      Int     @default(0)

  // Registration time - null for accounts created before it was recorded (2026-10-19)
  createdAt DateTime? @default(now())
}

model Category {
  id        String    @id
  name      Json // { ru, en }
  // Uploaded icon for the category filter pill (data URI or URL); null = fall back to the default red logo mark
  icon      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

enum ProductType {
  peptide
  additional_good
}

// The measurement unit each volume/price entry is denominated in. Independent of ProductType -
// a peptide can be sold as powder (mg) or pre-mixed liquid (ml), and an additional good can be
// unit-counted (pcs, e.g. syringes) or volume-based (ml, e.g. bacteriostatic water).
enum ProductUnit {
  mg
  ml
  pcs
}

// Base catalog entity shared by every sellable item, regardless of type. Type-specific
// attributes live on a details table (MedicineDetails today; more will follow as new
// product types need their own strongly-typed fields) so adding a new type never requires
// widening this table with nullable columns nobody else uses.
model Product {
  id              String      @id
  type            ProductType @default(peptide)
  unit            ProductUnit @default(mg)
  name            Json // { ru, en }
  categoryId      String      @default("weightloss")
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description     Json // { ru, en }
  fullDescription Json // { ru, en }
  images          Json @default("[]") // string[] of image URLs - images[0] is the cover photo
  rating          Float
  inStock         Int

  medicine        MedicineDetails?
  additionalGood  AdditionalGoodDetails?
}

// Peptide-specific clinical/dosing fields. Only exists for products with type = peptide.
model MedicineDetails {
  productId         String  @id
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  indications       Json // { ru: string[], en: string[] }
  contraindications Json // { ru: string[], en: string[] }
  usage             Json // { ru, en }
  form              String
  mgPerUnit         Float
  dosageRules       Json // { mgPerKgPerDay, defaultDailyDoses }
  // [{ mgPerUnit, price, priceUsd }] volume options - price lives only here, tied to the strength.
  volumes           Json @default("[]")
}

// Everything that isn't a peptide (syringes, vitamins, protein, cosmetics, equipment, ...).
// A single shared bucket until a specific type needs fields none of the others do - at that
// point it gets its own details table instead of widening this one.
model AdditionalGoodDetails {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // [{ mgPerUnit, price, priceUsd }] pack-size options - mgPerUnit here just means
  // "units per pack"
  volumes   Json @default("[]")
}

// Where orders can be shipped and what shipping costs there. Admin-managed so opening a new
// destination doesn't need a deploy - these fees used to be hardcoded in the frontend's
// currency.ts. There is deliberately no free-delivery tier: every country charges its flat fee.
model DeliveryCountry {
  code      String  @id // ISO 3166-1 alpha-2, uppercase (KZ, RU, UZ, ...)
  name      Json // { ru, en }
  priceKzt  Float   @default(0)
  priceUsd  Float   @default(0)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

// A code handed to a partner, who passes it on to their clients: the client types it at
// checkout and gets a percentage off. Percent rather than a fixed sum because the storefront
// sells in two currencies (KZT/USD) - one percentage covers both.
model PromoCode {
  code            String  @id // uppercase, exactly what the customer types
  partnerName     String  @default("") // whose code this is - the label in the admin stats table
  discountPercent Float // 0-100, taken off the goods subtotal only, never off delivery
  isActive        Boolean @default(true)
  maxUses         Int? // null = unlimited; counts orders, not people
  expiresAt       String? // ISO date, null = no expiry
  createdAt       String
}

model Order {
  id            String @id
  date          String
  userEmail     String
  items         Json // [{ medicineName, price, priceUsd, quantity }]
  totalPrice    Float // KZT grand total
  totalPriceUsd Float @default(0) // USD grand total
  address       Json // { city, street, apartment, postalCode }
  paymentMethod String
  status        String @default("pending")

  // Promo code used at checkout, uppercase. Deliberately plain text and not a relation to
  // PromoCode: deleting a retired code must not erase which orders it brought in, and the
  // "how many clients did this partner send" figures are counted from this column.
  promoCode       String?
  discountPercent Float   @default(0)
  // What the discount actually took off, per currency. The totalPrice* above are already net of it.
  discountKzt     Float   @default(0)
  discountUsd     Float   @default(0)

  @@index([promoCode])
}

model StockSubscription {
  id         String @id @default(cuid())
  email      String
  medicineId String
  notified   Int    @default(0)
  createdAt  String

  @@unique([email, medicineId])
}

model Notification {
  id         String @id @default(cuid())
  email      String
  medicineId String
  message    Json // { ru, en }
  createdAt  String
  read       Int    @default(0)
}

model NewsletterSubscriber {
  email     String @id
  createdAt String
}

// One screen view on a storefront, written by the browser through POST /api/analytics/track
// and read back only by the admin dashboard (GET /api/admin/analytics).
//
// "How many people came" is the number of distinct visitorId values; "how many visits" the
// number of distinct sessionId values. visitorId lives in the browser's localStorage and
// sessionId is renewed after 30 idle minutes, exactly like the two figures mean.
//
// Deliberately anonymous: no IP address, no email, no cross-site cookie - the only thing
// about the person is the country Cloudflare already stamps on every request.
//
// createdAt is a real timestamp instead of the ISO strings the older tables use: this is the
// one table that is queried by range and grouped by day, and a text column can't be indexed
// for that. The table also grows per page view, so AnalyticsService prunes old rows.
model VisitEvent {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String
  // The logical screen, not a URL: catalog | product | calculator | cart | orders | checkout
  path      String
  // Set only on `path = 'product'` - drives the "most viewed products" table
  productId String?
  // Host the visitor arrived from ('' = typed the address in or came from a private link)
  referrer  String   @default("")
  lang      String   @default("")
  device    String   @default("desktop") // desktop | mobile | tablet
  country   String   @default("") // ISO 3166-1 alpha-2, from Cloudflare's cf-ipcountry header
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A customer's private chat with the Telegram bot (nadeck-bot), recorded by ChatService so
// the admin panel's "Dialogs" tab can show it and a manager can answer in the bot's place.
// One row per Telegram user; group chats are never recorded.
model BotDialog {
  id            String             @id @default(cuid())
  telegramId    String             @unique // Telegram user id as text - it can outgrow a 32-bit Int
  username      String?
  name          String             @default("")
  // While this is in the future the advisor stays silent and a manager is answering instead.
  // Set by a manager's reply (and by "take over"), so a forgotten chat returns to the bot.
  pausedUntil   DateTime?
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  messages      BotDialogMessage[]

  @@index([lastMessageAt])
}

model BotDialogMessage {
  id        String    @id @default(cuid())
  dialogId  String
  dialog    BotDialog @relation(fields: [dialogId], references: [id], onDelete: Cascade)
  role      String // customer | bot | operator
  text      String
  orderId   String?
  createdAt DateTime  @default(now())

  @@index([dialogId, createdAt])
}

// A video in the feed or a photo in the gallery under the catalog, managed from the admin
// panel's "Videos & photos" tab. One table: they share every field, `kind` tells them apart.
model MediaItem {
  id        String   @id @default(cuid())
  kind      String   @default("video") // video | photo
  title     Json // { ru, en }
  src       String // <R2_PUBLIC_URL>/videos/<uuid>.mp4 or <R2_PUBLIC_URL>/gallery/<uuid>.jpg
  poster    String? // videos only: optional cover shown before playback
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([kind, sortOrder])
}
