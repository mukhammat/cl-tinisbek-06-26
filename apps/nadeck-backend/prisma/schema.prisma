generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email    String  @id
  password String
  fullName String
  phone    String  @default("")
  address  String  @default("")
  isAdmin  Boolean @default(false)
}

model Category {
  id         String     @id
  name       Json // { ru, en, ar }
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  medicines  Medicine[]
}

model Medicine {
  id                String @id
  name              Json // { ru, en, ar }
  categoryId        String @default("weightloss")
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  activeSubstance   Json // { ru, en, ar }
  description       Json // { ru, en, ar }
  fullDescription   Json // { ru, en, ar }
  indications       Json // { ru: string[], en: string[], ar: string[] }
  contraindications Json // { ru: string[], en: string[], ar: string[] }
  usage             Json // { ru, en, ar }
  price             Float
  image             String
  rating            Float
  form              String
  mgPerUnit         Float
  // [{ mgPerUnit, price }] volume options for the medicine
  volumes           Json @default("[]")
  dosageRules       Json // { mgPerKgPerDay, defaultDailyDoses }
  inStock           Int
}

model Order {
  id            String @id
  date          String
  userEmail     String
  items         Json // [{ medicineName, price, quantity }]
  totalPrice    Float
  address       Json // { city, street, apartment, postalCode }
  paymentMethod String
  status        String @default("pending")
}

model StockSubscription {
  id         String @id @default(cuid())
  email      String
  medicineId String
  notified   Int    @default(0)
  createdAt  String

  @@unique([email, medicineId])
}

model Notification {
  id         String @id @default(cuid())
  email      String
  medicineId String
  message    Json // { ru, en, ar }
  createdAt  String
  read       Int    @default(0)
}
