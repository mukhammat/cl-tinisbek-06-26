generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email    String  @id
  password String
  fullName String
  phone    String  @default("")
  address  String  @default("")
  isAdmin  Boolean @default(false)
}

model Medicine {
  id                String @id
  name              String
  category          String
  activeSubstance   String
  description       String
  fullDescription   String
  indications       String
  contraindications String
  usage             String
  price             Float
  image             String
  rating            Float
  form              String
  mgPerUnit         Float
  volumes           String @default("[]")
  dosageRules       String
  inStock           Int
}

model Order {
  id            String @id
  date          String
  userEmail     String
  items         String
  totalPrice    Float
  address       String
  paymentMethod String
  status        String @default("pending")
}

model StockSubscription {
  id         String @id @default(cuid())
  email      String
  medicineId String
  notified   Int    @default(0)
  createdAt  String

  @@unique([email, medicineId])
}

model Notification {
  id         String @id @default(cuid())
  email      String
  medicineId String
  message    String
  createdAt  String
  read       Int    @default(0)
}
