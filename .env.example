# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Postgres credentials for the docker-compose "db" service. DATABASE_URL is only needed
# for running Prisma commands (migrate/generate) directly on the host, outside Docker —
# inside docker-compose, backend's DATABASE_URL is built from these same POSTGRES_* vars.
POSTGRES_USER=nadeck
POSTGRES_PASSWORD=
POSTGRES_DB=nadeck
DATABASE_URL=postgresql://nadeck:CHANGE_ME@localhost:5432/nadeck

# Secret used to sign/verify the backend's login JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Used by docker-compose to run the nadeck-bot service.
TELEGRAM_BOT_TOKEN=
# No group id setting needed for the daily 9:00 / 19:00 (Asia/Almaty) greeting - the bot
# auto-detects every group it's added to (apps/nadeck-bot/src/groupStore.ts) and persists
# the list to apps/nadeck-bot/data/groups.json (docker volume, survives restarts).

# Used by docker-compose to run the gender-router-bot service (separate bot: greets new
# members of a group chat and routes them to a male/female chat by button choice).
# Create the bot via @BotFather (/newbot) - it's a different bot from TELEGRAM_BOT_TOKEN above.
GENDER_BOT_TOKEN=
# Invite links for the two destination chats (e.g. https://t.me/+xxxxxxxx, or https://t.me/name
# if it's a public chat/channel).
MALE_CHAT_LINK=https://t.me/male_chat
FEMALE_CHAT_LINK=https://t.me/female_chat

# OpenAI key/model. Shared by two independent uses:
# - Backend's /api/chat (AI Peptide Advisor widget on the website + nadeck-bot Q&A, which
#   forwards to this same endpoint - one AI + one knowledge base for both channels).
# - nadeck-bot's own daily group greeting (apps/nadeck-bot/src/greeting.ts) - a separate,
#   much smaller prompt with no FAQ/catalog knowledge, since it doesn't need any.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Where nadeck-bot reaches the backend. Defaults to localhost for local dev; docker-compose
# overrides this to http://backend:3001 directly (no need to set it here for Docker).
BACKEND_URL=http://localhost:3001

# Cloudflare R2 storage for product/category image uploads (Admin Panel "upload" fields).
# Create a bucket + API token in the Cloudflare Dashboard under R2 -> Manage API Tokens.
R2_ACCOUNT_ID=4982dccd74cab266cea19ea491832438
R2_ACCESS_KEY_ID=6c92dd653f91e012897a891870366b13
R2_SECRET_ACCESS_KEY=0e8256e90ad60d1d4d481f5b4c5a9dd67654224ad6dc8bdf3c0dcc04f7b8e1db
R2_BUCKET_NAME=nadeck
# Public base URL objects are served from (r2.dev public bucket URL, or a custom domain).
R2_PUBLIC_URL=https://pub-365eaf7f36cc461ca5a8e873593d83c1.r2.dev
