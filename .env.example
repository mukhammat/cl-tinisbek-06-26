# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Postgres credentials for the docker-compose "db" service. DATABASE_URL is only needed
# for running Prisma commands (migrate/generate) directly on the host, outside Docker —
# inside docker-compose, backend's DATABASE_URL is built from these same POSTGRES_* vars.
POSTGRES_USER=nadeck
POSTGRES_PASSWORD=
POSTGRES_DB=nadeck
DATABASE_URL=postgresql://nadeck:CHANGE_ME@localhost:5432/nadeck

# Used by docker-compose to run the nadeck-bot service.
TELEGRAM_BOT_TOKEN=

# OpenAI key/model powering the backend's /api/chat (AI Peptide Advisor widget on the
# website). The nadeck-bot Telegram bot forwards to this same endpoint, so there's one
# AI + one knowledge base for both channels.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Where nadeck-bot reaches the backend. Defaults to localhost for local dev; docker-compose
# overrides this to http://backend:3001 directly (no need to set it here for Docker).
BACKEND_URL=http://localhost:3001
